//---break and continue----
cout<< "\nSkipping 3 using continue, stopping at 7 using break:
" <<endl;
for(int i = 1; i<=10; i++) {
	if (i == 3) continue; // skip this iteration
	if (i == 7) break; // exit this iteration
	cout << i << " ";
 }
